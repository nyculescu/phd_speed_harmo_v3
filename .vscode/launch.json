{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug RL Learn with Memory Profiler",
            "type": "debugpy",
            "request": "launch",
            "module": "memory_profiler",
            "args": ["rl_learn.py"],
            "justMyCode": false,
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "D:\\progr_files\\Eclipse\\Sumo\\tools;${workspaceFolder};${env:PYTHONPATH}",
                "PYTHONUNBUFFERED": "1"
            },
            "envFile": "${workspaceFolder}/.venv"
        },
        {
            "name": "Run: Option 1 (Single Train)", // Renamed for clarity
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/drl_vsl.py",
            "console": "integratedTerminal",
            "args": [
                "--option", "1",
                "--n_envs", "2", // number of environments
                "--algo", "DQN",
                "--reward_fn", "mobility",
                "--vsl_mode", "cavs_only",
                // "--use_tuned_hp"
            ]
        },
        {
            "name": "Run: Option 2 (Parallel Combo Train)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/drl_vsl.py",
            "console": "integratedTerminal",
            "args": [
                "--option", "2"
            ]
        },
        {
            "name": "Run: Option 3 (Single Eval)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/drl_vsl.py",
            "console": "integratedTerminal",
            "args": [
                "--option", "3",
                "--algo", "DQN",
                "--reward_fn", "mobility",
                "--vsl_mode", "cavs_only",
                // "--use_tuned_hp"
            ]
        },
        {
            "name": "Run: Option 4 (Parallel Eval)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/drl_vsl.py",
            "console": "integratedTerminal",
            "args": [
                "--option", "4"
            ]
        },
        {
            "name": "Run: Flow Gen",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/flow_gen.py",
            "console": "integratedTerminal",

        },
        {
            "name": "Run: Hyper Parameter Tuning",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/drl_vsl_hp-tune.py",
            "console": "integratedTerminal",

        },
    ]
}